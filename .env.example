# ── Voice mode ──────────────────────────────────────────────────────────────
# "cascaded" : Twilio Gather (STT) -> LLM -> Say (TTS). Turn-based, cheap, no
#              barge-in. Uses the LLM provider settings below.
# "realtime" : Twilio Media Streams <-> OpenAI Realtime speech-to-speech.
#              Native barge-in (caller can talk over the bot and it adapts).
VOICE_MODE=cascaded

# -- Realtime path (VOICE_MODE=realtime) --
# Which barge-in phone brain to run:
#   "openai"   : OpenAI Realtime speech-to-speech (native barge-in, priciest —
#                ~$0.06/min in, ~$0.24/min out).
#   "deepgram" : Deepgram STT + your text LLM (LLM_PROVIDER, e.g. Claude on
#                Vertex) + Deepgram Aura TTS, with VAD barge-in. Much cheaper
#                (~$0.06–0.09 per 3-min call). See docs/deepgram-cascade.md.
#   "gemini"   : Gemini Live on Vertex AI — the same class of fused duplex
#                model as "openai", but inside Google Cloud: auth is ADC (no
#                API key exists for it), it falls under the same GCP BAA as the
#                compute, and it bills to the same project. Needs
#                VERTEX_PROJECT_ID set. See the GEMINI_LIVE_* block below.
REALTIME_PROVIDER=openai

# OpenAI Realtime (REALTIME_PROVIDER=openai). For HIPAA, request a BAA at
# baa@openai.com and use a zero-data-retention configuration before real PHI.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy

# Deepgram cascade (REALTIME_PROVIDER=deepgram). One key covers STT + TTS; the
# reasoning uses your LLM_PROVIDER below. Both audio legs run at μ-law 8 kHz to
# match Twilio with no transcoding. Deepgram signs a BAA for HIPAA use.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall
# Elle's voice. aura-2-thalia-en is a bright, high-energy American female.
# Brightness matters more on a phone than it looks: the call is G.711 at 8 kHz,
# which throws away everything under ~300 Hz, so a low voice arrives thin and
# muddy rather than warm. Other bright options, roughly brightest first:
# aura-2-electra-en, aura-stella-en, aura-2-amalthea-en, aura-2-juno-en.
# aura-athena-en is the older British voice, lower and calmer.
# ./tools/preview-voices.sh renders the greeting through each so you can
# choose by ear; pass --phone to hear them as a caller actually would.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Trailing silence (ms) before Elle decides the caller is done talking. Higher =
# more patient (won't interrupt a mid-thought pause) but slower to reply.
DEEPGRAM_ENDPOINTING_MS=1000

# ── Languages ─────────────────────────────────────────────────────────────────
# Languages Elle can hold a conversation in. More than one turns on bilingual
# mode: code-switching STT (DEEPGRAM_STT_MULTI_MODEL, language=multi — callers
# can change language mid-call), a per-language TTS voice, a mirror-the-caller
# persona rule, and a short Spanish invitation at the end of the phone greeting.
# Set LANGUAGES=en for the original English-only stack. Claude itself is
# natively multilingual, so the text brain needs no configuration.
LANGUAGES=en,es
DEEPGRAM_STT_MULTI_MODEL=nova-3
# Elle's Spanish voice (Aura-2 Spanish catalog). Alternatives:
# aura-2-estrella-es, aura-2-diana-es, aura-2-javier-es, aura-2-nestor-es.
DEEPGRAM_TTS_MODEL_ES=aura-2-celeste-es

# Gemini Live on Vertex AI (REALTIME_PROVIDER=gemini). No key: auth is
# Application Default Credentials, the same as the Vertex LLM path below, so on
# Cloud Run it is the service account already attached. Project id comes from
# VERTEX_PROJECT_ID. The Live API is not offered in every region, so its
# location is set separately from VERTEX_REGION. Voices are Gemini's own
# prebuilt set (Aoede, Puck, Charon, Kore, Fenrir, ...), not Deepgram's.
# Verify the model id is enabled for your project before relying on it:
#   ./tools/smoke-gemini-live.sh
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio
GEMINI_LIVE_LOCATION=us-central1
GEMINI_LIVE_VOICE=Aoede

# ── LLM provider (text brain: cascaded voice + website chat) ──────────────────
# "anthropic" : Claude via api.anthropic.com (default)
# "vertex"    : Claude via Google Vertex AI — same model, but inside Google
#               Cloud, so it's covered by your GCP BAA (no separate model-vendor
#               BAA). See docs/vertex-baa.md.
# "openai"    : any OpenAI-compatible endpoint (Hugging Face, Together, Groq,
#               Fireworks, vLLM, a self-hosted fine-tune, ...)
LLM_PROVIDER=anthropic

# -- Anthropic path (LLM_PROVIDER=anthropic) --
# claude-haiku-4-5 is the cheap default ($1/$5 per MTok); use claude-opus-5
# if you want maximum conversation quality.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# -- Vertex AI path (LLM_PROVIDER=vertex) --
# No API key: auth is Google Application Default Credentials (the machine's
# service account on Cloud Run/GCE, or `gcloud auth application-default login`
# locally). VERTEX_MODEL must be the exact Model Garden id available in your
# region — e.g. claude-sonnet-4-5@20250929. See docs/vertex-baa.md.
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5
VERTEX_MODEL=claude-sonnet-4-5@20250929

# -- OpenAI-compatible path (LLM_PROVIDER=openai) --
# Examples:
#   Hugging Face router:  OPENAI_BASE_URL=https://router.huggingface.co/v1
#                         OPENAI_API_KEY=hf_...   OPENAI_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   HF Inference Endpoint (incl. your own fine-tune deployed on TGI):
#                         OPENAI_BASE_URL=https://<endpoint>.endpoints.huggingface.cloud/v1
#   Groq:                 OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Together:             OPENAI_BASE_URL=https://api.together.xyz/v1
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Bot behavior ────────────────────────────────────────────────────────────
# interview: the bot represents YOU (needs profile.md) and answers callers'
#            questions about your background — like they're interviewing you.
# learn:     the bot interviews the CALLER and records facts about them.
# Leave unset to auto-select: interview if profile.md exists, else learn.
#BOT_MODE=interview
PROFILE_PATH=profile.md

# Your name — used in the assistant's persona ("Elle, <name>'s outreach assistant").
PROFILE_NAME=

# The assistant's own name / persona (your AI outreach assistant).
ASSISTANT_NAME=Elle

# Directory of markdown files forming the RAG knowledge base (resume, projects,
# skills). Each heading becomes a retrievable chunk. See docs/rag.md.
KNOWLEDGE_DIR=knowledge

# ── Server ──────────────────────────────────────────────────────────────────
# Public base URL of THIS SERVICE (your ngrok URL or domain). Used for Twilio
# webhooks, the media stream, and signature validation.
PUBLIC_URL=http://localhost:3000
PORT=3000

# The HUMAN-facing website: where visitors and callers are sent. The chat and
# the call-pairing screen both live on ASK_PATH there, so the web experience is
# one page rather than split across two domains. Defaults to PUBLIC_URL.
SITE_URL=https://lewiswcampbell.com
ASK_PATH=/ask.html

# Optional but recommended: your Twilio auth token, used to verify that
# webhook requests really come from Twilio.
TWILIO_AUTH_TOKEN=

# Local development only: run without Twilio request authentication. With no
# auth token the server refuses to boot, because the webhook signature checks
# and the /media stream token cannot work without one; this flag is the
# explicit opt-in that replaces silently skipping them.
# ALLOW_UNSIGNED_TWILIO=1

# Outbound SMS (the verbal-opt-in confirmation text). Both required for
# outbound sends; webhook replies work without them. TWILIO_FROM_NUMBER is
# your Twilio number in E.164 form, e.g. +19495551234.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# Text-to-speech voice for <Say>. See Twilio's docs for available voices.
TTS_VOICE=Google.en-US-Chirp3-HD-Aoede

# Where the SQLite database is stored
SQLITE_PATH=letstalk.db

# ── Repeat-caller escalation (cost protection) ────────────────────────────────
# Recognizes callers by number and escalates treatment if the same number dials
# repeatedly within ABUSE_WINDOW_HOURS:
#   up to ABUSE_LIMITED_AFTER calls : normal.
#   past ABUSE_LIMITED_AFTER        : "limited" — bot keeps it short; the barge-in
#                                     call is hard-capped at ABUSE_LIMITED_MAX_SECONDS.
#   past ABUSE_BLOCK_AFTER          : "blocked" — brief spoken message then hang up,
#                                     without starting the paid speech/LLM pipeline.
ABUSE_WINDOW_HOURS=24
ABUSE_LIMITED_AFTER=3
ABUSE_BLOCK_AFTER=6
ABUSE_LIMITED_MAX_SECONDS=120
# Hard ceiling on ANY realtime call (seconds; default 600). A stuck line or
# autodialer that never hangs up can't run an open-ended bill.
MAX_CALL_SECONDS=600
# Hang up if the caller says nothing this long after the call starts (default
# 75s = the ~25s greeting + a generous pause). Robocall probes connect and sit
# silent; a real caller always speaks sooner. 0 disables.
SILENT_HANGUP_SECONDS=75

# ── Call recording + blob storage (realtime path) ─────────────────────────────
# When enabled, each call is captured as a stereo WAV (caller left, Elle right)
# and uploaded to a Google Cloud Storage bucket with a JSON sidecar (metadata +
# transcript). OFF by default — recording has consent/compliance implications
# (announce it, honor two-party-consent law, sign the GCS BAA for PHI). Auth is
# ADC: the Cloud Run service account needs write access to the bucket. See
# docs/recording.md.
RECORDING_ENABLED=false
RECORDING_BUCKET=
RECORDING_PREFIX=recordings

# ── Intro-call booking ────────────────────────────────────────────────────────
# Elle's goal is to book callers for a short intro call. When BOOKING_CALENDAR_ID
# is set, she creates a TENTATIVE hold on that Google Calendar (which you then
# confirm) and tells the caller it's pending. With no calendar set she still
# captures the request as a lead. Auth is ADC: share the calendar with the Cloud
# Run service account and grant "Make changes to events". See docs/booking.md.
# Legal name of the A2P 10DLC brand, exactly as registered. Named only in
# SMS HELP and consent replies, where carriers require it. Set once.
BRAND_NAME=

BOOKING_CALENDAR_ID=
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_DURATION_MINUTES=30
# Working hours (weekdays, booking timezone) used only to suggest open times
# when a requested time is busy. Callers can still book any time.
BOOKING_HOURS=9-17

# Owner-only admin views (e.g. /admin/bookings, the pending-confirmation list).
# Empty disables them (routes 404). Pass as an X-Admin-Token header or ?token=.
ADMIN_TOKEN=

# ── Telegram owner intake ─────────────────────────────────────────────────────
# Lewis's private channel for directing Elle's outreach: message the bot a name
# and phone number, she texts that person (via Twilio) to set up an intro call,
# and their replies flow into the SMS agent with the outreach context. Get the
# bot token from @BotFather; invent a random TELEGRAM_WEBHOOK_SECRET and pass
# the same value to setWebhook (Telegram echoes it back so only Telegram can
# post to /telegram); TELEGRAM_OWNER_ID is your numeric user id — leave it blank
# on first deploy and the bot will reply to your first message with the id.
# Leave TELEGRAM_BOT_TOKEN empty to disable the whole feature.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Calendars checked for CONFLICTS but never written to. Without these, Elle
# books straight over anything on your personal calendar, because free/busy
# only ever saw the calendar she writes to. Comma-separated ids, each shared
# with the service account at "See only free/busy" or better.
# BOOKING_BUSY_CALENDARS=personal@gmail.com,family@group.calendar.google.com

# Calls allowed at once. Past this the next caller is told to text instead of
# hearing silence.
# MAX_CONCURRENT_CALLS=20

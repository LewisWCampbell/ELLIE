# Copy to gcp.env and fill in. Every script here sources it.

# The project to bill. Elle's own project works; a separate one keeps costs apart.
export GCP_PROJECT=""
# A zone that has your GPU type (A100 80GB is in fewer zones than you'd hope).
export GCP_ZONE="us-central1-a"
export VM_NAME="elle-train"
# One A100 80GB. For one H100 instead: a3-highgpu-1g.
export MACHINE_TYPE="a2-ultragpu-1g"
# 1 = Spot: much cheaper, can be stopped by Google at any time. Training
# resumes from the last checkpoint when the VM starts again.
export SPOT=1
# 490 GB: under the 500 GB-per-region SSD quota new projects start with
# (balanced disks count as SSD). Peak use is about 320 GB: ~245 GB of stereo
# training audio, ~25 GB of models, ~15 GB of Python environments, checkpoints.
export BOOT_DISK_GB=490
# pd-balanced: about 40% cheaper than pd-ssd and ample for this job.
export BOOT_DISK_TYPE="pd-balanced"
# Deep Learning VM image family (CUDA + drivers). Empty = pick the newest CUDA 12 one.
export IMAGE_FAMILY=""
# Checkpoints and reports are copied here, so nothing is lost with the VM.
export BUCKET="gs://${GCP_PROJECT}-elle-training"
export REPO_URL="https://github.com/LewisWCampbell/ELLIE"
